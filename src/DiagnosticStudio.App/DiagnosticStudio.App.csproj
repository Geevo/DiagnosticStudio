<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiagnosticStudio.Core\DiagnosticStudio.Core.csproj" />
    <ProjectReference Include="..\DiagnosticStudio.Ingestion\DiagnosticStudio.Ingestion.csproj" />
    <ProjectReference Include="..\DiagnosticStudio.Parsers\DiagnosticStudio.Parsers.csproj" />
    <ProjectReference Include="..\DiagnosticStudio.Search\DiagnosticStudio.Search.csproj" />
    <ProjectReference Include="..\DiagnosticStudio.Rules\DiagnosticStudio.Rules.csproj" />
    <ProjectReference Include="..\DiagnosticStudio.Timeline\DiagnosticStudio.Timeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiagnosticStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The program is DiagnosticStudio.exe; the project and its namespaces keep the .App name. -->
    <AssemblyName>DiagnosticStudio</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent light/dark following Windows) is still flagged experimental by WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
