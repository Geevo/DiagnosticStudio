<UserControl x:Class="DiagnosticStudio.App.Views.DateTimeBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="CalendarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SelectedLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- The calendar button sits beside the box, not over it, so the box's own clear (X) button stays visible. -->
        <TextBox x:Name="Box" Height="26" MinHeight="0" Padding="4,0,4,0" VerticalContentAlignment="Center"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=LostFocus}" KeyDown="OnBoxKeyDown" />
        <Button x:Name="CalendarButton" Grid.Column="1" Style="{StaticResource CalendarButton}" Width="26"
                Height="26" Focusable="False" ToolTip="Pick a date" Click="OnCalendarClick"
                FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE787;" />
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="False"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="4">
                <StackPanel>
                    <Calendar x:Name="Picker" SelectedDatesChanged="OnDatePicked" PreviewMouseUp="OnCalendarMouseUp" />
                    <StackPanel Orientation="Horizontal" Margin="6,4,6,2">
                        <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TimeBox" Width="90" Height="26" MinHeight="0" VerticalContentAlignment="Center"
                                 ToolTip="Time of day, UTC (HH:mm or HH:mm:ss). It is used when a day is picked; press Enter to apply it to the day already in the box."
                                 KeyDown="OnTimeBoxKeyDown" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
