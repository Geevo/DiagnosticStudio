<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3794D6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA0A6" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#0E639C" />

    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F48771" />
    <SolidColorBrush x:Key="CriticalTextBrush" Color="#FF6B5A" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E5B567" />
    <SolidColorBrush x:Key="DebugTextBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TimestampTextBrush" Color="#7FA1D4" />
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#3A3320" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#6B5D2A" />
    <SolidColorBrush x:Key="SelectedLineBrush" Color="#264F78" />
    <SolidColorBrush x:Key="MatchLineBrush" Color="#44391A" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#E61E1E1E" />
</ResourceDictionary>
