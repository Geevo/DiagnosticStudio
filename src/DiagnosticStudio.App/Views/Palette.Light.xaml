<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E639C" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#0E639C" />
    <SolidColorBrush x:Key="StatusBarTrackBrush" Color="#59FFFFFF" />

    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />
