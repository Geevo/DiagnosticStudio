<UserControl x:Class="DiagnosticStudio.App.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagnosticStudio.App.ViewModels">

    <UserControl.Resources>
        <!-- One of the Errors / Warnings / Messages filters: a glyph and a count, outlined while it is on. -->
        <Style x:Key="SeverityFilter" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedLineBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProblemItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
            <EventSetter Event="KeyDown" Handler="OnItemKeyDown" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Show in timeline"
                                  Command="{Binding PlacementTarget.Tag.ShowInTimelineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                    <ToggleButton Style="{StaticResource SeverityFilter}" IsChecked="{Binding ShowErrors}"
                                  ToolTip="Show or hide errors: findings of error severity and files that could not be read.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource ErrorTextBrush}"
                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorsLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SeverityFilter}" IsChecked="{Binding ShowWarnings}"
                                  ToolTip="Show or hide warnings: findings of warning severity and files only partly read.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource WarningTextBrush}"
                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WarningsLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SeverityFilter}" IsChecked="{Binding ShowMessages}"
                                  ToolTip="Show or hide messages: information findings, files opened with a caution, with no viewer, or empty.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MessagesLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ProgressBar DockPanel.Dock="Top" Height="2" IsIndeterminate="True" BorderThickness="0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEvaluating}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <TreeView ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource ProblemItemStyle}"
                  BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:ProblemGroupViewModel}" ItemsSource="{Binding Findings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SeverityGlyph}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type vm:FileProblemGroupViewModel}" ItemsSource="{Binding Items}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SeverityGlyph}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:FileProblemViewModel}">
                    <StackPanel Margin="0,2" ToolTip="{Binding Where}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Where}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Margin="20,0,0,0" />
                        <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Margin="20,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </DataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type vm:FindingViewModel}" ItemsSource="{Binding Evidence}">
                    <StackPanel Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ArtifactName}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:EvidenceViewModel}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Location}">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ArtifactName}" Width="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</UserControl>
