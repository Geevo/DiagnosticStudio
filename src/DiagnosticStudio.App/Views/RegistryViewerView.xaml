<UserControl x:Class="DiagnosticStudio.App.Views.RegistryViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticStudio.App.Views"
             xmlns:rv="clr-namespace:DiagnosticStudio.App.ViewModels.RegistryViewer"
             xmlns:docs="clr-namespace:DiagnosticStudio.Core.Documents;assembly=DiagnosticStudio.Core"
             PreviewKeyDown="OnPreviewKeyDown"
             DataContextChanged="OnDataContextChanged">

    <UserControl.Resources>
        <Style x:Key="KeyItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource GridRowStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BannerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BannerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource BannerStyle}"
                Visibility="{Binding WarningText, Converter={x:Static local:NullToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
            <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <TabControl TabStripPlacement="Bottom" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Registry">
                <DockPanel>
                    <!-- Find -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="FindBox" Width="260" VerticalContentAlignment="Center"
                                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search key names, value names and value data (Ctrl+F). A query containing '\' matches full key paths."
                                     KeyDown="OnFindBoxKeyDown" />
                            <ToggleButton Content="Aa" Margin="4,0,0,0" Padding="6,2" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                            <Button Margin="4,0,0,0" Padding="6,2" Command="{Binding FindPreviousCommand}" ToolTip="Previous match (Shift+F3)"
                                    FontFamily="{StaticResource IconFont}" Content="&#xE70E;" />
                            <Button Margin="2,0,0,0" Padding="6,2" Command="{Binding FindNextCommand}" ToolTip="Next match (F3)"
                                    FontFamily="{StaticResource IconFont}" Content="&#xE70D;" />
                            <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Key tree -->
                        <TreeView x:Name="KeyTree" Grid.Column="0" ItemsSource="{Binding Roots}" Loaded="OnTreeLoaded"
                                  ItemContainerStyle="{StaticResource KeyItemStyle}" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type rv:RegistryKeyNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

                        <!-- Values -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="110" MinHeight="40" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="6,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Raw source" Margin="6,0,0,0" Padding="8,2"
                                            Command="{Binding ShowInRawSourceCommand}" ToolTip="Show the selected key or value in the raw source" />
                                    <Button DockPanel.Dock="Right" Content="Copy value" Margin="6,0,0,0" Padding="8,2"
                                            Click="OnCopyValue" ToolTip="Copy the selected value's data" />
                                    <Button DockPanel.Dock="Right" Content="Copy path" Margin="6,0,0,0" Padding="8,2"
                                            Click="OnCopyPath" ToolTip="Copy the selected key path" />
                                    <TextBox Text="{Binding SelectedKeyPath, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                            </Border>

                            <ListView x:Name="ValueList" Grid.Row="1" ItemsSource="{Binding Values}"
                                      SelectedItem="{Binding SelectedValue, Mode=TwoWay}" SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource ValueRowStyle}" BorderThickness="0"
                                      VirtualizingPanel.IsVirtualizing="True">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type docs:RegistryValue}">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding TypeName}" />
                                        <GridViewColumn Header="Value" Width="520">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type docs:RegistryValue}">
                                                    <TextBlock Text="{Binding DisplayValue}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayValue}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

                            <TextBox Grid.Row="3" Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Padding="6,4" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw source">
                <ContentControl Content="{Binding Raw}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
