<UserControl x:Class="DiagnosticStudio.App.Views.SearchResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticStudio.App.Views"
             xmlns:s="clr-namespace:DiagnosticStudio.App.ViewModels.Search">

    <UserControl.Resources>
        <Style x:Key="ResultItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <EventSetter Event="KeyDown" Handler="OnItemKeyDown" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Show in timeline"
                                  Command="{Binding PlacementTarget.Tag.ShowHitInTimelineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HitTemplate" DataType="{x:Type s:SearchHitViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LocationText}" Width="150" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <local:MatchTextBlock Preview="{Binding Preview}" MatchStart="{Binding MatchStart}"
                                      MatchLength="{Binding MatchLength}" VerticalAlignment="Center"
                                      FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Status and options -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Match case" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding MatchCase}" />
                    <CheckBox Content="Include event messages" Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding IncludeEventMessages}"
                              ToolTip="Also search event message text. Slower: each event's message is rendered from provider metadata." />
                    <CheckBox Content="File names" VerticalAlignment="Center" IsChecked="{Binding IncludeFileNames}"
                              ToolTip="Also match artifact names and their path inside the archive." />
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="Cancel" Margin="0,0,8,0" Padding="8,1" Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding QueryError}" Foreground="{DynamicResource ErrorTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           DockPanel.Dock="Left"
                           Visibility="{Binding QueryError, Converter={x:Static local:NullToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <ProgressBar DockPanel.Dock="Top" Height="2" Minimum="0" Maximum="{Binding ArtifactsTotal}"
                     Value="{Binding ArtifactsSearched, Mode=OneWay}" BorderThickness="0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Results grouped by artifact -->
        <TreeView x:Name="ResultTree" ItemsSource="{Binding Results}" ItemContainerStyle="{StaticResource ResultItemStyle}"
                  BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type s:SearchArtifactNodeViewModel}"
                                          ItemsSource="{Binding Hits}" ItemTemplate="{StaticResource HitTemplate}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Provenance}">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Provenance}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</UserControl>
