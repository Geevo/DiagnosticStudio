<UserControl x:Class="DiagnosticStudio.App.Views.StructuredViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticStudio.App.Views"
             xmlns:sv="clr-namespace:DiagnosticStudio.App.ViewModels.StructuredViewer"
             PreviewKeyDown="OnPreviewKeyDown"
             DataContextChanged="OnDataContextChanged">

    <UserControl.Resources>
        <Style x:Key="NodeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
            <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <TabControl TabStripPlacement="Bottom" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Structure">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBanner}"
                            Visibility="{Binding ReadProblemText, Converter={x:Static local:NullToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding ReadProblemText}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Find -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="FindBox" Width="260" VerticalContentAlignment="Center"
                                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search names and values (Ctrl+F)"
                                     KeyDown="OnFindBoxKeyDown" />
                            <ToggleButton Content="Aa" Margin="4,0,0,0" Padding="6,2" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                            <Button Margin="4,0,0,0" Padding="6,2" Command="{Binding FindPreviousCommand}" ToolTip="Previous match (Shift+F3)"
                                    FontFamily="{StaticResource IconFont}" Content="&#xE70E;" />
                            <Button Margin="2,0,0,0" Padding="6,2" Command="{Binding FindNextCommand}" ToolTip="Next match (F3)"
                                    FontFamily="{StaticResource IconFont}" Content="&#xE70D;" />
                            <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <!-- Node tree -->
                        <TreeView x:Name="NodeTree" Grid.Column="0" ItemsSource="{Binding Roots}" Loaded="OnTreeLoaded"
                                  ItemContainerStyle="{StaticResource NodeItemStyle}" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type sv:StructuredNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Width="22" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

                        <!-- Detail -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="6,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Raw" Margin="6,0,0,0" Padding="8,2"
                                            Command="{Binding ShowInRawSourceCommand}" ToolTip="Show the selected node in the raw source" />
                                    <Button DockPanel.Dock="Right" Content="Copy value" Margin="6,0,0,0" Padding="8,2"
                                            Click="OnCopyValue" ToolTip="Copy the selected node's value" />
                                    <Button DockPanel.Dock="Right" Content="Copy path" Margin="6,0,0,0" Padding="8,2"
                                            Click="OnCopyPath" ToolTip="Copy the selected node's path" />
                                    <TextBox Text="{Binding SelectedPath, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding DetailInfo}" Margin="8,4" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBox Grid.Row="2" Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Padding="6,4" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw source">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Content="Indent" Padding="10,2" Margin="0,0,10,0"
                                          IsChecked="{Binding PrettyRaw}" IsEnabled="{Binding PrettyAvailable}"
                                          ToolTip="Show the file re-indented. The text is unchanged; only line breaks and indentation are added." />
                            <TextBlock Text="{Binding PrettyStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </DockPanel>
                    </Border>
                    <ContentControl Content="{Binding ActiveRaw}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
