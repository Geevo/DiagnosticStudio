<UserControl x:Class="DiagnosticStudio.App.Views.TableViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticStudio.App.Views"
             xmlns:tb="clr-namespace:DiagnosticStudio.App.ViewModels.TableViewer"
             PreviewKeyDown="OnPreviewKeyDown"
             DataContextChanged="OnDataContextChanged">

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="RecordRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource GridRowStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusyBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="2" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFiltering}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel>
                <local:ZoomBox DockPanel.Dock="Left" Margin="0,0,10,0" />
                <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl TabStripPlacement="Bottom" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Table">
                <DockPanel>
                    <!-- Lines that are not part of any record -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBanner}"
                            Visibility="{Binding UnreadText, Converter={x:Static local:NullToVisibilityConverter.Instance}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Show first" Margin="10,0,0,0" Padding="10,1" MinHeight="0"
                                    Command="{Binding ShowFirstUnreadLineCommand}" />
                            <TextBlock Text="{Binding UnreadText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Filter -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,4"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <WrapPanel>
                                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="FilterBox" Width="260" Margin="0,0,10,4" Style="{StaticResource CompactBox}"
                                         VerticalContentAlignment="Center" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show only records that contain this text (Ctrl+F). Escape clears it." />
                                <ComboBox Width="170" Margin="0,0,10,4" Style="{StaticResource CompactCombo}"
                                          ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLevel}"
                                          Visibility="{Binding HasLevels, Converter={StaticResource BoolToVisibility}}" ToolTip="Level" />
                                <Button Content="Clear" Margin="0,0,10,4" Style="{StaticResource CompactButton}" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" />

                    <local:ScaledContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="110" MinHeight="50" />
                            </Grid.RowDefinitions>

                            <ListView x:Name="RowList" Grid.Row="0" ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Extended"
                                      ItemContainerStyle="{StaticResource RecordRowStyle}" BorderThickness="0"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLog}" Value="True">
                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                <Setter Property="FontSize" Value="11.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy rows" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Show in raw source"
                                                  Command="{Binding PlacementTarget.DataContext.ShowInRawSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

                            <!-- Detail -->
                            <DockPanel Grid.Row="2">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelHeaderBrush}" Padding="6,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Raw" Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                                Command="{Binding ShowInRawSourceCommand}" ToolTip="Show this record in the raw source" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                                Click="OnCopyDetail" ToolTip="Copy this record's text" />
                                        <TextBlock Text="{Binding DetailInfo}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                </Border>
                                <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" Padding="6,4" />
                            </DockPanel>
                        </Grid>
                    </local:ScaledContent>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw source">
                <ContentControl Content="{Binding Raw}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
