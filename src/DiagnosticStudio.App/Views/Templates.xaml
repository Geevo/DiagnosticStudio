<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticStudio.App.ViewModels"
                    xmlns:tv="clr-namespace:DiagnosticStudio.App.ViewModels.TextViewer"
                    xmlns:rv="clr-namespace:DiagnosticStudio.App.ViewModels.RegistryViewer"
                    xmlns:ev="clr-namespace:DiagnosticStudio.App.ViewModels.EventLogViewer"
                    xmlns:sv="clr-namespace:DiagnosticStudio.App.ViewModels.StructuredViewer"
                    xmlns:tl="clr-namespace:DiagnosticStudio.App.ViewModels.Timeline"
                    xmlns:tb="clr-namespace:DiagnosticStudio.App.ViewModels.TableViewer"
                    xmlns:hv="clr-namespace:DiagnosticStudio.App.ViewModels.HtmlViewer"
                    xmlns:views="clr-namespace:DiagnosticStudio.App.Views">

    <!-- Key/value rows with a shared label column, used by the Overview and artifact documents. -->
    <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailRow}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0" />
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OverviewDocumentViewModel}">
        <views:ScaledContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,20" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="INVESTIGATION SUMMARY" FontSize="14" FontWeight="SemiBold" />

                    <TextBlock Text="{Binding EmptyMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Sections}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverviewSection}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ATTENTION NEEDED">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding DataContext.Problems.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />

                        <ItemsControl ItemsSource="{Binding DataContext.Problems.Attention, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                    <Button HorizontalContentAlignment="Left" Padding="6,4" Margin="0,1" BorderThickness="0" Background="Transparent"
                                            Command="{Binding DataContext.Problems.OpenFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Open the first piece of evidence">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SeverityGlyph}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="820" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="820"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Show all in Problems" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2"
                                Command="{Binding DataContext.ShowProblemsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Problems.HasFindings, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:ScaledContent>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tv:TextViewerViewModel}">
        <views:TextViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ev:EventLogViewerViewModel}">
        <views:EventLogViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tl:TimelineDocumentViewModel}">
        <views:TimelineView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type hv:HtmlViewerViewModel}">
        <views:HtmlViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tb:TableViewerViewModel}">
        <views:TableViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type sv:StructuredViewerViewModel}">
        <views:StructuredViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type rv:RegistryViewerViewModel}">
        <views:RegistryViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ArtifactDocumentViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelHeaderBrush}" Padding="8,3"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,0" MinHeight="0" BorderThickness="0" Background="Transparent"
                            FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE72C;"
                            ToolTip="Refresh: read this file from disk again (F5)"
                            Command="{Binding DataContext.Documents.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding Artifact.ProvenanceDisplay}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedTextBrush}" ToolTip="{Binding Artifact.ProvenanceDisplay}" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBanner}">
                <Border.Visibility>
                    <Binding Path="IsEmpty">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter />
                        </Binding.Converter>
                    </Binding>
                </Border.Visibility>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="This file is empty." />
                    <Run Text="It has no content (0 bytes), so there is nothing to show. It was empty when it was collected, or it was cut short." />
                </TextBlock>
            </Border>

            <Grid>
                <ContentControl Content="{Binding Viewer}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <TextBlock Text="Empty file" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding Viewer, Converter={x:Static views:NullToBooleanConverter.Instance}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Metadata view: shown while loading and for artifacts without a viewer. -->
                <views:ScaledContent>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Viewer, Converter={x:Static views:NullToBooleanConverter.Instance}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="20,12,20,20" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Loading..." Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="ARTIFACT" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource DetailRowTemplate}"
                                          Grid.IsSharedSizeScope="True" />
                        </StackPanel>
                    </ScrollViewer>
                </views:ScaledContent>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
