<UserControl x:Class="DiagnosticStudio.App.Views.TextViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticStudio.App.Views"
             xmlns:vm="clr-namespace:DiagnosticStudio.App.ViewModels.TextViewer"
             PreviewKeyDown="OnPreviewKeyDown"
             DataContextChanged="OnDataContextChanged">

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <Style x:Key="LineTextStyle" TargetType="local:HighlightedTextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Line" Value="{Binding}" />
            <Setter Property="Highlight" Value="{Binding DataContext.HighlightText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="MatchCase" Value="{Binding DataContext.MatchCase, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="Selection" Value="{Binding DataContext.Selection, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.WrapText, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MatchLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Debug">
                    <Setter Property="Foreground" Value="{DynamicResource DebugTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:LineViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding DataContext.GutterWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding LineNumber}" HorizontalAlignment="Right" Margin="0,0,6,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Border>
                <local:HighlightedTextBlock Grid.Column="1" Margin="8,0,8,0" Style="{StaticResource LineTextStyle}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Find / go to line / options -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FindBox" Width="220" VerticalContentAlignment="Center"
                         Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Find in this file (Ctrl+F). Enter: next, Shift+Enter: previous"
                         KeyDown="OnFindBoxKeyDown" />
                <ToggleButton Content="Aa" Margin="4,0,0,0" Padding="6,2" IsChecked="{Binding MatchCase}"
                              ToolTip="Match case" />
                <Button Margin="4,0,0,0" Padding="6,2" Command="{Binding FindPreviousCommand}" ToolTip="Previous match (Shift+F3)"
                        FontFamily="{StaticResource IconFont}" Content="&#xE70E;" />
                <Button Margin="2,0,0,0" Padding="6,2" Command="{Binding FindNextCommand}" ToolTip="Next match (F3)"
                        FontFamily="{StaticResource IconFont}" Content="&#xE70D;" />
                <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="90"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <Separator Margin="8,0" />

                <TextBlock Text="Line" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="GoToBox" Width="80" VerticalContentAlignment="Center"
                         Text="{Binding GoToLineText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Go to line (Ctrl+G)" KeyDown="OnGoToBoxKeyDown" />
                <Button Content="Go" Margin="4,0,0,0" Padding="8,2" Command="{Binding GoToLineCommand}" />
                <TextBlock Text="{Binding GoToLineError}" Foreground="{DynamicResource ErrorTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />

                <Separator Margin="8,0" />

                <CheckBox Content="Wrap" IsChecked="{Binding WrapText}" VerticalAlignment="Center" ToolTip="Word wrap" />
                <ToggleButton Content="Lines" Margin="10,0,0,0" Padding="8,2" IsChecked="{Binding LineSelection}"
                              ToolTip="Select whole lines instead of text. Off: drag across text to mark any part of it; double-click selects a word, triple-click or the line number a line." />
                <Button Content="Copy" Margin="4,0,0,0" Padding="8,2" Command="ApplicationCommands.Copy"
                        CommandTarget="{Binding ElementName=LineList}" ToolTip="Copy the selection (Ctrl+C)" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionInfo}" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <local:ScaledContent>
            <ListBox x:Name="LineList" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}"
                     ItemContainerStyle="{StaticResource LineItemStyle}"
                     SelectionMode="Extended" BorderThickness="0"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True"
                     SelectionChanged="OnSelectionChanged"
                     PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                     PreviewMouseLeftButtonUp="OnListMouseUp" LostMouseCapture="OnListLostCapture">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WrapText}" Value="True">
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>
        </local:ScaledContent>
    </DockPanel>
</UserControl>
