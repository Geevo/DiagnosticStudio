<UserControl x:Class="DiagnosticStudio.App.Views.ZoomBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagnosticStudio.App.ViewModels">
    <!-- A list of common levels that also takes a typed one, like the zoom box of a code editor. -->
    <ComboBox x:Name="Box" IsEditable="True" Width="96" MinHeight="0" Padding="4,1"
              ItemsSource="{x:Static vm:ZoomViewModel.Presets}"
              Text="{Binding Entry, Mode=OneWay}"
              ToolTip="Zoom of the document pane. Type a level and press Enter, or Ctrl+mouse wheel over a document."
              SelectionChanged="OnSelectionChanged"
              PreviewKeyDown="OnKeyDown"
              LostKeyboardFocus="OnLostFocus" />
</UserControl>
