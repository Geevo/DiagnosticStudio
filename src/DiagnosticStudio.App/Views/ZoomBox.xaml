<UserControl x:Class="DiagnosticStudio.App.Views.ZoomBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagnosticStudio.App.ViewModels">
    <UserControl.Resources>
        <!-- The text field and arrow are plain: the box sits in a status line and must not be taller than the text beside it. -->
        <Style x:Key="ZoomField" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomArrow" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0,3,3,0">
                            <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="3" BorderThickness="1" Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ZoomField}" Margin="7,0,18,0"
                                     VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}" />
                            <ToggleButton Style="{StaticResource ZoomArrow}" HorizontalAlignment="Right" Width="18" Margin="0,1,1,1"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <!-- Opens upwards: the box is at the bottom of the window. -->
                            <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="2">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- A list of common levels that also takes a typed one, like the zoom box of a code editor. -->
    <!-- The box has its own style, so the theme's text colour does not reach it unless it is taken from the window. -->
    <ComboBox x:Name="Box" Style="{StaticResource ZoomCombo}"
              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
              ItemsSource="{x:Static vm:ZoomViewModel.Presets}"
              Text="{Binding Entry, Mode=OneWay}"
              ToolTip="Zoom of the document pane. Type a level and press Enter, or Ctrl+mouse wheel over a document."
              SelectionChanged="OnSelectionChanged"
              PreviewKeyDown="OnKeyDown"
              LostKeyboardFocus="OnLostFocus" />
</UserControl>
