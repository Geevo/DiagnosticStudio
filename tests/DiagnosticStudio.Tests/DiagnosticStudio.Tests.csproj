<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode is still flagged experimental by WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The WPF SDK drops this implicit using (System.Windows.Shapes.Path clashes with System.IO.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- A 32 KB trace of four events from a .NET runtime, written by logman on a development machine. -->
    <None Include="Parsers\Fixtures\small-trace.etl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiagnosticStudio.Core\DiagnosticStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.Ingestion\DiagnosticStudio.Ingestion.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.Parsers\DiagnosticStudio.Parsers.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.Search\DiagnosticStudio.Search.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.Rules\DiagnosticStudio.Rules.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.Timeline\DiagnosticStudio.Timeline.csproj" />
    <ProjectReference Include="..\..\src\DiagnosticStudio.App\DiagnosticStudio.App.csproj" />
  </ItemGroup>

</Project>